# Environment configuration (placeholder — this project has no secrets by
# default; everything runs locally with SQLite). Kept for parity with the
# requested project structure and as a place to add config if you extend
# the project (e.g. a real Kaggle API key, a hosted Postgres URL, etc.)

# Example if you later swap SQLite for another DB:
# DATABASE_URL=postgresql://user:password@localhost:5432/fraud_detection

# Example if you wire in a real claims API:
# CLAIMS_API_KEY=
# CLAIMS_API_BASE_URL=

APP_ENV=development
